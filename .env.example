# Server-side configuration. Copy to .env and explicitly load it into your shell.
# Local DEV is accepted only with this exact APP_ENV and a loopback HTTP_ADDR.
APP_ENV=development
AUTH_PROVIDER=local_dev
HTTP_ADDR=127.0.0.1:8080

# Fixed local identity; these are safe examples, not external login credentials.
# Issuer is reserved for Local DEV; email_verified is always false.
LOCAL_DEV_SUBJECT=local-developer
LOCAL_DEV_EMAIL=developer@example.invalid
LOCAL_DEV_DISPLAY_NAME='Local Developer'

# To use OIDC, set AUTH_PROVIDER=oidc and fill in all four settings below.
# Register this exact redirect URI with a confidential web client at your provider.
# OIDC supports development, test/TEST and production/prd/PRD with PostgreSQL.
OIDC_ISSUER_URL=https://identity.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost:5173/api/auth/callback
OIDC_ALLOW_HTTP_DEVELOPMENT=false

# OIDC requires PostgreSQL and manually applied migrations. Local DEV also requires a readable startup policy database.
# Keep your existing DB_* values when updating an actual .env file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=go_web_framework
DB_USER=go_web_app
DB_PASSWORD=
# disable is accepted ONLY for loopback PostgreSQL in APP_ENV=development.
# TEST/PRD require verify-full and an absolute path to the trusted database CA.
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_MAX_CONNS=10

# Go durations. Idle must not exceed absolute; absolute is also capped by ID-token expiry.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h

# HTTPS is the default for OIDC. Export both absolute file paths when running
# Vite for OIDC. Leave empty for the existing HTTP Local DEV workflow.
# Keep trusted local certificate/private-key files outside the repository.
DEV_TLS_CERT_FILE=
DEV_TLS_KEY_FILE=

# Never prefix backend authentication configuration/secrets with VITE_.

# Phase 5: enable RBAC/Admin Portal after manually applying migration 000004.
# Disabled leaves RBAC APIs unavailable; authentication startup still checks database policy.
RBAC_ENABLED=false
# Exact browser origin for CSRF checks on ALL RBAC/account writes (no trailing /).
# TEST/PRD require https://your-app.example; loopback HTTP is development-only.
APP_ORIGIN=http://127.0.0.1:5173
# DB_* is required for startup policy checks with every provider, even without RBAC.
# Admin is NEVER assigned automatically; see the one-time bootstrap in README.

# Phase 8.1: compile-time application modules. Blank disables all modules.
# Requires RBAC_ENABLED=true, explicit AUTH_PROVIDER, APP_ORIGIN and DB_*.
# Exact lowercase IDs separated by commas; no spaces, duplicates or unknown IDs.
# Currently available: example. Restart after changing this value.
# Phase 8.3: example requires its independent version-1 migration; see README.
# Startup validates migrations read-only; it never installs schemas or journals.
ENABLED_MODULES=
# Declaring/enabling a module NEVER inserts permissions or grants them to Admin.
# The example endpoints deny access until an approved example.read grant exists.

# Phase 9.2.2 management-only admin APIs; runtime login still uses AUTH_PROVIDER
# and the provider environment settings above. Requires RBAC_ENABLED=true and
# existing migration 000006. A valid deployment scope and readable PostgreSQL
# policy are mandatory at startup. Missing encryption keys disable management
# (protected HTTP 503) without changing the environment provider. Restart required.
# Use a unique deployment ID and distinct encryption key for each DEV/TEST/PRD.
AUTH_CONFIG_DEPLOYMENT=
AUTH_ENCRYPTION_KEY_ID=
# Canonical padded standard base64 encoding of 32 cryptographically random bytes.
# Keep the real value outside Git; never reuse key IDs for replacement key bytes.
AUTH_ENCRYPTION_KEY=

# Required before the protected activation preparation/readiness APIs are used.
# single_instance is valid only when exactly one application replica serves the
# workflow. session_affinity requires ingress affinity from preparation through
# normal callback readiness and activation. Blank keeps activation disabled.
AUTH_ACTIVATION_AFFINITY_MODE=

# Offline emergency OIDC recovery is a separate break-glass capability. Keep
# disabled during ordinary operation. The authorization key must be a distinct,
# random 32-byte value in canonical padded standard Base64, held in protected
# operator/server secret storage. Never reuse AUTH_ENCRYPTION_KEY.
AUTH_RECOVERY_ENABLED=false
AUTH_RECOVERY_OPERATOR_ID=
AUTH_RECOVERY_AUTHORIZATION_KEY_ID=
AUTH_RECOVERY_AUTHORIZATION_KEY=
