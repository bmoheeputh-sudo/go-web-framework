# Backend-only configuration. Copy to .env and explicitly load it into your shell.
# Local DEV is accepted only with this exact APP_ENV and a loopback HTTP_ADDR.
APP_ENV=development
AUTH_PROVIDER=local_dev
HTTP_ADDR=127.0.0.1:8080

# Fixed local identity; these are safe examples, not external login credentials.
# Issuer is reserved for Local DEV; email_verified is always false.
LOCAL_DEV_SUBJECT=local-developer
LOCAL_DEV_EMAIL=developer@example.invalid
LOCAL_DEV_DISPLAY_NAME='Local Developer'

# Never prefix backend authentication configuration/secrets with VITE_.
