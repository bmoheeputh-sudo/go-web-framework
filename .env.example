# Server-side configuration. Copy to .env and explicitly load it into your shell.
# Local DEV is accepted only with this exact APP_ENV and a loopback HTTP_ADDR.
APP_ENV=development
AUTH_PROVIDER=local_dev
HTTP_ADDR=127.0.0.1:8080

# Fixed local identity; these are safe examples, not external login credentials.
# Issuer is reserved for Local DEV; email_verified is always false.
LOCAL_DEV_SUBJECT=local-developer
LOCAL_DEV_EMAIL=developer@example.invalid
LOCAL_DEV_DISPLAY_NAME='Local Developer'

# To use OIDC, set AUTH_PROVIDER=oidc and fill in all four settings below.
# Register this exact redirect URI with a confidential web client at your provider.
# OIDC supports development, test/TEST and production/prd/PRD with PostgreSQL.
OIDC_ISSUER_URL=https://identity.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost:5173/api/auth/callback
OIDC_ALLOW_HTTP_DEVELOPMENT=false

# To use IAP, set AUTH_PROVIDER=google_iap and explicitly configure ONE audience.
# Copy Signed Header JWT Audience from the IAP resource; never use an OAuth client ID.
# App Engine: /projects/PROJECT_NUMBER/apps/PROJECT_ID
# Backend service (including an IAP connector for AWS EC2):
# /projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
# Direct Cloud Run IAP: /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
# Blank intentionally: IAP mode fails startup until this is configured.
IAP_AUDIENCE=
# External hosts need supported IAP connector/proxy infrastructure AND origin
# network restrictions. Setting these variables alone does not enable Google IAP.
# Verification is always enforced; no metadata server or service account is needed.

# OIDC requires PostgreSQL and manually applied migrations. Local DEV and IAP do not.
# Keep your existing DB_* values when updating an actual .env file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=go_web_framework
DB_USER=go_web_app
DB_PASSWORD=
# disable is accepted ONLY for loopback PostgreSQL in APP_ENV=development.
# TEST/PRD require verify-full and an absolute path to the trusted database CA.
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_MAX_CONNS=10

# Go durations. Idle must not exceed absolute; absolute is also capped by ID-token expiry.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h

# HTTPS is the default for OIDC. Export both absolute file paths when running
# Vite for OIDC. Leave empty for the existing HTTP Local DEV workflow.
# Keep trusted local certificate/private-key files outside the repository.
DEV_TLS_CERT_FILE=
DEV_TLS_KEY_FILE=

# Never prefix backend authentication configuration/secrets with VITE_.
